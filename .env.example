# Optional local endpoint overrides; defaults are localhost.
FD_MAX_URL=http://127.0.0.1:8774
FD_OMNI_URL=http://127.0.0.1:8775
FD_FIRST_TIMEOUT=8
FD_TIMEOUT=1
# Optional fixed post-result budget (seconds), still capped by gate.yaml.
# Otherwise derived from measured lane cost; FD_TIMEOUT is the fallback/floor.
# FD_POST_TIMEOUT=15
# Optional fixed budget (seconds) for gate/classify/route/verify model calls,
# still capped by each pack's policy.budget.max_budget_s. Otherwise derived from
# the measured cost model; FD_TIMEOUT is the fallback/floor.
# FD_CALL_TIMEOUT=5
